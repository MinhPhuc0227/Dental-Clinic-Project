@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container">

    <section class="page-hero">
        <h1>Giới thiệu</h1>
        <p>Trang chủ / Giới thiệu</p>
    </section>

    <section class="about-section">

        <div class="about-content">
            <h2>Chào mừng đến với Phòng khám Nha khoa MP</h2>

            <p>
                Phòng khám Nha khoa MP cung cấp các dịch vụ chăm sóc răng miệng
                chất lượng cao trong môi trường thân thiện, chuyên nghiệp và tận tâm.
            </p>

            <p>
                Với đội ngũ bác sĩ giàu kinh nghiệm cùng hệ thống trang thiết bị
                hiện đại, chúng tôi mang đến nhiều giải pháp nha khoa phù hợp
                với nhu cầu của từng khách hàng.
            </p>

            <p>
                Sự an toàn, thoải mái và hài lòng của khách hàng luôn là ưu tiên
                hàng đầu của Phòng khám Nha khoa MP.
            </p>
        </div>

        <div class="about-image">
            <img src="~/images/about-clinic.jpg"
                 alt="Phòng khám Nha khoa MP" />
        </div>

    </section>

    <section class="about-features">

        <div class="about-feature">
            <h3>Đội ngũ bác sĩ giàu kinh nghiệm</h3>
            <p>
                Đội ngũ bác sĩ có chuyên môn cao, giàu kinh nghiệm và luôn
                tận tâm trong quá trình thăm khám và điều trị.
            </p>
        </div>

        <div class="about-feature">
            <h3>Trang thiết bị hiện đại</h3>
            <p>
                Phòng khám được trang bị các thiết bị nha khoa hiện đại,
                hỗ trợ chẩn đoán và điều trị hiệu quả.
            </p>
        </div>

        <div class="about-feature">
            <h3>Khách hàng là ưu tiên</h3>
            <p>
                Chúng tôi luôn đặt sự an toàn, thoải mái và trải nghiệm của
                khách hàng lên hàng đầu.
            </p>
        </div>

    </section>

</div>