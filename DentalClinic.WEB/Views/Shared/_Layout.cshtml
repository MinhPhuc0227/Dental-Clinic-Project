@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dental Clinic</title>

    <meta name="description"
          content="Dental Clinic - Chăm sóc và điều trị răng miệng chuyên nghiệp." />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Header -->
    <header class="site-header">
        <div class="container header-inner">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="logo">
                <img src="~/images/logo-mp.png" alt="Nha khoa MP" />
                <span>Nha khoa MP</span>
            </a>

            <!-- Navigation -->
            <!-- Navigation -->
            <nav class="main-nav" aria-label="Main navigation">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="@(currentController == "Home" ? "active" : "")">
                    Trang chủ
                </a>

                <a asp-controller="Service"
                   asp-action="Index"
                   class="@(currentController == "Service" ? "active" : "")">
                    Dịch vụ
                </a>

                <a asp-controller="Doctor"
                   asp-action="Index"
                   class="@(currentController == "Doctor" ? "active" : "")">
                    Bác sĩ
                </a>

                <a asp-controller="About"
                   asp-action="Index"
                   class="@(currentController == "About" ? "active" : "")">
                    Về chúng tôi
                </a>

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="@(currentController == "Contact" ? "active" : "")">
                    Liên hệ
                </a>

                <a asp-controller="Appointment"
                   asp-action="Index"
                   class="btn-appointment @(currentController == "Appointment" ? "active" : "")">
                    Đặt lịch
                </a>

                @if (Context.Session.GetInt32("PatientId").HasValue)
                {
                    <div class="user-menu">

                        <button type="button"
                                class="user-menu-button"
                                onclick="toggleUserMenu()"
                                aria-expanded="false">
                            <span class="user-icon">👤</span>
                            <span>
                                @Context.Session.GetString("FullName")
                            </span>
                            <span class="user-arrow">▼</span>
                        </button>

                        <div class="user-dropdown" id="userDropdown">

                            <a asp-controller="Account"
                               asp-action="Profile"
                               class="@(currentController == "Account" && currentAction == "Profile" ? "active" : "")">
                                Hồ sơ cá nhân
                            </a>

                            <a asp-controller="Appointment"
                               asp-action="MyAppointments"
                               class="@(currentController == "Appointment" && currentAction == "MyAppointments" ? "active" : "")">
                                Lịch hẹn của tôi
                            </a>

                            <a asp-controller="MedicalRecord"
                               asp-action="History"
                               class="@(currentController == "MedicalRecord" && currentAction == "History" ? "active" : "")">
                                Lịch sử khám
                            </a>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit">
                                    Đăng xuất
                                </button>

                            </form>

                        </div>

                    </div>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="@(currentController == "Account" && currentAction == "Login" ? "active" : "")">
                        Đăng nhập
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="@(currentController == "Account" && currentAction == "Register" ? "active" : "")">
                        Đăng ký
                    </a>
                }

            </nav>

        </div>
    </header>

    <!-- Main -->
    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <!-- Footer -->
    <footer class="site-footer">

        <div class="container footer-inner">

            <!-- Clinic -->
            <div class="footer-column footer-brand">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="footer-logo">
                    <img src="~/images/logo-mp.png"
                         alt="Nha khoa MP" />
                    <span>Nha khoa MP</span>
                </a>

                <p>
                    Chăm sóc sức khỏe răng miệng chuyên nghiệp,
                    tận tâm và luôn đặt khách hàng lên hàng đầu.
                </p>
            </div>

            <!-- About -->
            <div class="footer-column">
                <h3>Về chúng tôi</h3>

                <a asp-controller="About"
                   asp-action="Index">
                    Giới thiệu
                </a>

                <a asp-controller="Doctor"
                   asp-action="Index">
                    Đội ngũ bác sĩ
                </a>

                <a asp-controller="Service"
                   asp-action="Index">
                    Dịch vụ nha khoa
                </a>

                <a asp-controller="Contact"
                   asp-action="Index">
                    Liên hệ
                </a>
            </div>

            <!-- Customer -->
            <div class="footer-column">
                <h3>Dành cho khách hàng</h3>

                <a asp-controller="Appointment"
                   asp-action="Index">
                    Đặt lịch khám
                </a>

                @if (Context.Session.GetInt32("PatientId").HasValue)
                {
                    <a asp-controller="Appointment"
                       asp-action="MyAppointments">
                        Lịch hẹn của tôi
                    </a>

                    <a asp-controller="MedicalRecord"
                       asp-action="History">
                        Lịch sử khám
                    </a>

                    <a asp-controller="Account"
                       asp-action="Profile">
                        Hồ sơ cá nhân
                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">
                        Đăng nhập
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register">
                        Đăng ký
                    </a>
                }
            </div>

            <!-- Contact -->
            <div class="footer-column">
                <h3>Liên hệ</h3>

                <p>
                    <strong>Hotline:</strong><br />
                    0123 456 789
                </p>

                <p>
                    <strong>Email:</strong><br />
                    contact@nhakhoamp.com
                </p>

                <p>
                    <strong>Giờ làm việc:</strong><br />
                    Thứ Hai - Thứ Bảy<br />
                    08:00 - 17:00
                </p>
            </div>

        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>
                    &copy; @DateTime.Now.Year Nha khoa MP.
                    All rights reserved.
                </p>
            </div>
        </div>

    </footer>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>