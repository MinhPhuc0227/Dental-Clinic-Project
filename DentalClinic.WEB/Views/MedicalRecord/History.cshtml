@model List<DentalClinic.DTO.MedicalHistoryDto>

@{
    ViewData["Title"] = "Lịch sử khám";
}

<section class="container appointment-page">

    <div class="page-heading">
        <h1>Lịch sử khám</h1>

        <p>
            Xem lại thông tin các lần khám đã hoàn thành.
        </p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <p>Bạn chưa có lịch sử khám.</p>
        </div>
    }
    else
    {
        <div class="history-list">

            @foreach (var record in Model)
            {
                <article class="history-item">

                    <div class="history-date">
                        @record.ExaminationDate.ToString("dd/MM/yyyy HH:mm")
                    </div>

                    <div class="history-content">

                        <h2>
                            @record.DoctorName
                        </h2>

                        <p>
                            <strong>Chẩn đoán:</strong>
                            @record.Diagnosis
                        </p>

                        <p>
                            <strong>Kết luận:</strong>
                            @record.Conclusion
                        </p>

                    </div>

                </article>
            }

        </div>
    }

</section>