@model DentalClinic.DTO.DoctorDto

@{
    ViewData["Title"] = "Chi tiết bác sĩ";
}

<section class="container doctor-detail-page">

    <div class="doctor-detail-card">

        <div>
            <h1>@Model.FullName</h1>

            <p>
                <strong>Mô tả:</strong>
                @Model.Description
            </p>

            <p>
                <strong>Số điện thoại:</strong>
                @Model.Phone
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

            <p>
                <strong>Giới thiệu:</strong>
                @Model.Description
            </p>
        </div>

        <div>
            <a asp-controller="Appointment"
               asp-action="Create"
               asp-route-doctorId="@Model.DoctorId"
               class="btn-appointment">
                Đặt lịch với bác sĩ
            </a>
        </div>

    </div>

</section>