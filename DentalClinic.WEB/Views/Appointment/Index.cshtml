@model DentalClinic.DTO.OnlineAppointmentCreateDto

@{
    ViewData["Title"] = "Đặt lịch";

    var doctors =
        ViewBag.Doctors as List<DentalClinic.DTO.Common.LookupItemDto>
        ?? new List<DentalClinic.DTO.Common.LookupItemDto>();
}

<section class="container appointment-page">

    <div class="page-heading">
        <h1>Đặt lịch khám</h1>

        <p>
            Đặt lịch khám trực tuyến tại Dental Clinic.
        </p>
    </div>

    <div class="appointment-card">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Index" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>

            <div class="form-group">
                <label asp-for="DoctorId">
                    Bác sĩ
                </label>

                <select asp-for="DoctorId"
                        class="form-control">

                    <option value="">
                        -- Chọn bác sĩ --
                    </option>

                    @foreach (var doctor in doctors)
                    {
                        <option value="@doctor.Id">
                            @doctor.Name
                        </option>
                    }
                </select>

                <span asp-validation-for="DoctorId"
                      class="field-validation-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="AppointmentDate">
                    Ngày khám
                </label>

                <input asp-for="AppointmentDate"
                       type="date"
                       class="form-control" />

                <span asp-validation-for="AppointmentDate"
                      class="field-validation-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="AppointmentTime">
                    Giờ khám
                </label>

                <input asp-for="AppointmentTime"
                       type="time"
                       class="form-control" />

                <span asp-validation-for="AppointmentTime"
                      class="field-validation-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="ReasonForVisit">
                    Lý do khám
                </label>

                <textarea asp-for="ReasonForVisit"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="ReasonForVisit"
                      class="field-validation-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Note">
                    Ghi chú
                </label>

                <textarea asp-for="Note"
                          class="form-control"
                          rows="3"></textarea>

                <span asp-validation-for="Note"
                      class="field-validation-error">
                </span>
            </div>

            <button type="submit"
                    class="btn-appointment">
                Đặt lịch
            </button>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}