@model List<DentalClinic.DTO.ServiceDto>

@{
    ViewData["Title"] = "Dịch vụ";
}

<section class="container services-page">

    <div class="page-heading">
        <h1>Dịch vụ nha khoa</h1>
        <p>
            Các dịch vụ chăm sóc và điều trị răng miệng tại Dental Clinic.
        </p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <p>Hiện chưa có dịch vụ nào.</p>
    }
    else
    {
        <div class="services-grid">
            @foreach (var service in Model)
            {
                <article class="service-card">
                    <h2>@service.ServiceName</h2>

                    @if (!string.IsNullOrWhiteSpace(service.Description))
                    {
                        <p>@service.Description</p>
                    }

                    <strong>
                        @service.UnitPrice.ToString("N0") VNĐ
                    </strong>
                </article>
            }
        </div>
    }

</section>